{
  "group": "project-breakpoints",
  "titleKey": "featureGroup.projectBreakpoints",
  "features": [
    {
      "id": "project-breakpoints",
      "titleKey": "feature.projectBreakpoints",
      "commands": [
        "breakpoints.add",
        "breakpoints.rename",
        "breakpoints.setWidth",
        "breakpoints.remove",
        "workspace.openDialog",
        "view.setBreakpoint",
        "view.setViewportWidth"
      ],
      "dependsOn": [
        "breakpoints-switch"
      ],
      "spec": "spec/BEHAVIOUR.md#project-breakpoints",
      "intent": {
        "title": "The project's own breakpoints",
        "steps": [
          "Drag the canvas to a width and make a breakpoint there.",
          "Open Breakpoints and rename one, give it another width, or remove it."
        ],
        "expected": [
          "A made breakpoint gets its tab, is shown, and the export writes its media query.",
          "A width stays between its neighbours; a removed breakpoint takes the styles set at it along; every change is one undo step."
        ]
      },
      "scenarios": [
        {

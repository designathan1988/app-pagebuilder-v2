    {
      "id": "code-panel-edit-css",
      "titleKey": "feature.codePanelEditCss",
      "commands": [
        "style.applyCssRule"
      ],
      "dependsOn": [
        "code-panel-view"
      ],
      "spec": "spec/BEHAVIOUR.md#code-panel-edit-css",
      "intent": {
        "title": "Edit an element's CSS in the Code panel",
        "steps": [
          "Select a Heading and open the CSS tab.",
          "Edit its rule: change a value, add a declaration, remove one, then apply.",
          "Type invalid CSS and apply."
        ],
        "expected": [
          "Applying replaces the element's styles in the document JSON with the declarations of its rule as one undo step; the inspector and canvas update.",
          "Invalid CSS is refused with the line and reason, and the document JSON is unchanged.",
          "The rule is edited for the active breakpoint and state."
        ]
      },
      "scenarios": [

    {
      "id": "code-panel-selection-sync",
      "titleKey": "feature.codePanelSelectionSync",
      "commands": [
        "selection.select"
      ],
      "dependsOn": [
        "code-panel-view"
      ],
      "spec": "spec/BEHAVIOUR.md#code-panel-selection-sync",
      "intent": {
        "title": "Code panel follows the selection",
        "steps": [
          "Open the Code panel and select an element on the canvas.",
          "Click a line inside another element's markup in the HTML tab."
        ],
        "expected": [
          "Selecting an element highlights its markup lines in HTML and its rules in CSS and scrolls them into view.",
          "Clicking inside an element's markup selects that element on the canvas and in Layers."
        ]
      },
      "scenarios": [

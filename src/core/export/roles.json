{
  "en": {
    "section": ["Seção", "Section"],
    "title": ["Título", "Heading", "Title"],
    "text": ["Texto", "Text", "Paragraph", "Parágrafo"],
    "hero": ["Hero", "Destaque"],
    "card": ["Card", "Cartão"],
    "nav": ["Nav", "Navigation", "Navegação"],
    "header": ["Header", "Cabeçalho"],
    "footer": ["Footer", "Rodapé"],
    "button": ["Button", "Botão"],
    "image": ["Image", "Imagem"],
    "container": ["Div", "Container", "Contêiner"],
    "link": ["Link"]
  },
  "pt": {
    "secao": ["Seção", "Section"],
    "titulo": ["Título", "Heading", "Title"],
    "texto": ["Texto", "Text", "Paragraph", "Parágrafo"],
    "destaque": ["Hero", "Destaque"],
    "cartao": ["Card", "Cartão"],
    "navegacao": ["Nav", "Navigation", "Navegação"],
    "cabecalho": ["Header", "Cabeçalho"],
    "rodape": ["Footer", "Rodapé"],
    "botao": ["Button", "Botão"],
    "imagem": ["Image", "Imagem"],
    "conteiner": ["Div", "Container", "Contêiner"],
    "link": ["Link"]
  },
  "layout": {
    "grid": "node.name.grid",
    "column": "node.name.column",
    "row": "node.name.row",
    "block": "node.name.container"
  },
  "layoutProperties": ["display", "flex-direction"],
  "layoutValues": {
    "grid": ["grid", "inline-grid"],
    "flex": ["flex", "inline-flex"],
    "column": ["column", "column-reverse"]
  },
  "layoutTypes": ["div"],
  "modifiers": [
    { "kind": "tag", "tags": ["h1", "h2", "h3", "h4", "h5", "h6"] },
    { "kind": "lightness", "properties": ["background-color"], "en": { "dark": "dark", "light": "light", "other": "accent" }, "pt": { "dark": "escuro", "light": "claro", "other": "destaque" } },
    { "kind": "presence", "properties": ["background-image"], "en": { "present": "pictured", "absent": "plain" }, "pt": { "present": "com-imagem", "absent": "simples" } },
    { "kind": "lightness", "properties": ["color"], "en": { "dark": "dark-text", "light": "inverse", "other": "tinted" }, "pt": { "dark": "texto-escuro", "light": "invertido", "other": "colorido" } },
    { "kind": "size", "properties": ["font-size"], "en": { "more": "large", "less": "small" }, "pt": { "more": "grande", "less": "pequeno" } },
    { "kind": "size", "properties": ["font-weight"], "en": { "more": "bold", "less": "regular" }, "pt": { "more": "negrito", "less": "regular" } },
    { "kind": "presence", "properties": ["box-shadow"], "en": { "present": "raised", "absent": "flat" }, "pt": { "present": "elevado", "absent": "plano" } },
    { "kind": "presence", "properties": ["border-top-style", "border-right-style", "border-bottom-style", "border-left-style"], "en": { "present": "outlined", "absent": "borderless" }, "pt": { "present": "contornado", "absent": "sem-borda" } },
    { "kind": "size", "properties": ["padding-top", "padding-right", "padding-bottom", "padding-left"], "en": { "more": "spacious", "less": "compact" }, "pt": { "more": "amplo", "less": "compacto" } },
    { "kind": "size", "properties": ["max-width", "width"], "en": { "more": "wide", "less": "narrow" }, "pt": { "more": "largo", "less": "estreito" } },
    { "kind": "layout" },
    { "kind": "fallback", "en": "alt", "pt": "alt" }
  ]
}
